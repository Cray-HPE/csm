@Library('csm-shared-library') _

def COMPILE_BUILD = 0

def isPublishedRelease() {
    return (env.TAG_NAME ==~ /v[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)\.[0-9]+)?/)
}

def isReleaseBranch() {
    return (env.BRANCH_NAME ==~ /release\/.*/)
}

// Integration builds are triggered strictly by timer on release branch.
// To switch between manual/auto mode, comment/restore triggers{...} section in pipeline below.
def isIntegrationBuild() {
    return isReleaseBranch() && jenkinsUtils.isTriggeredByTimer()
}

pipeline {
    agent {
        label "metal-gcp-builder"
    }

    triggers {
        cron(isReleaseBranch() ? "0 2 * * 1-5" : "")
    }

    options {
        timeout(time: 240, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '5'))
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        DOCS_CSM_BRANCH = "release/1.6"
        CSM_BASE_VERSION = ""
        ARTIFACTORY = credentials('artifactory-algol60-readonly')
        PARALLEL_JOBS = "75%"
        SNYK_TOKEN = credentials('SNYK_TOKEN')
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    env.ARTIFACTORY_USER = env.ARTIFACTORY_USR
                    env.ARTIFACTORY_TOKEN = env.ARTIFACTORY_PSW
                    env.RELEASE_NAME = "csm"
                    env.RELEASE_VERSION = sh(script: './version.sh', returnStdout: true).trim()
                    if ( isIntegrationBuild() ) {
                        println "Integration nightly build detected."
                        env.RELEASE_VERSION = env.RELEASE_VERSION.split("-")[0] + "-nightly.1"
                        println "Overriding CSM RELEASE_VERSION as ${env.RELEASE_VERSION}."
                        env.DOCS_CSM_VERSION = csmUtils.findDocsCsmByBranch(env.DOCS_CSM_BRANCH)
                        println "Evaluated docs-csm version built from branch ${env.DOCS_CSM_BRANCH} as ${env.DOCS_CSM_VERSION}."
                        env.CSM_VSHASTA = "percy"
                        env.CSM_VSHASTA_UPGRADE = "pike"
                        env.SLACK_CHANNEL_NOTIFY = "#csm-nightly-automation"
                        env.RELEASE_DOCS_CSM = "false"
                        env.UPLOAD_TO_CSMPIT = "false"
                        env.VSHASTA_INSTALL = "true"
                        env.VSHASTA_UPGRADE = "true"
                        env.SEND_SNYK_REPORT = "true"
                        env.SNYK_REPORT_CHANNEL = "#casm-vulnerability-metrics"
                        env.SNYK_RESULTS_FILENAME = "${env.RELEASE_NAME}-${env.RELEASE_VERSION}-${(new Date()).format("yyyyMMddHHmmss")}-scans.tar.gz"
                    } else {
                        println "Integration nightly build not detected, using default settings."
                        env.DOCS_CSM_VERSION = ""
                        env.CSM_VSHASTA = "yasha"
                        env.CSM_VSHASTA_UPGRADE = "vex"
                        env.SLACK_CHANNEL_NOTIFY = "#casm_release_management"
                        env.RELEASE_DOCS_CSM = "true"
                        env.UPLOAD_TO_CSMPIT = "true"
                        env.VSHASTA_INSTALL = "true"
                        env.VSHASTA_UPGRADE = "true"
                        env.SEND_SNYK_REPORT = "true"
                        env.SNYK_REPORT_CHANNEL = "#casm-vulnerability-metrics"
                        env.SNYK_RESULTS_FILENAME = "${env.RELEASE_NAME}-${env.RELEASE_VERSION}-scans.tar.gz"
                    }
                    env.RELEASE = "${env.RELEASE_NAME}-${env.RELEASE_VERSION}"
                    env.RELEASE_MAJOR_MINOR = sh(script: 'echo $RELEASE_VERSION | cut -d . -f 1,2', returnStdout: true).trim()
                    env.RELEASE_BASEURL = "https://artifactory.algol60.net/artifactory/csm-releases/${env.RELEASE_NAME}/${env.RELEASE_MAJOR_MINOR}"
                    env.RELEASE_FILENAME = "${env.RELEASE_NAME}-${env.RELEASE_VERSION}.tar.gz"
                    env.RELEASE_URL = "${env.RELEASE_BASEURL}/${env.RELEASE_FILENAME}"
                    env.SNYK_RESULTS_URL = "${env.RELEASE_BASEURL}/${env.SNYK_RESULTS_FILENAME}"
                    env.SNYK_RESULTS_SHEET = "${env.RELEASE_NAME}-${env.RELEASE_VERSION}-snyk-results.xlsx"
                    env.SNYK_RESULTS_SHEET_URL = "${env.RELEASE_BASEURL}/${env.SNYK_RESULTS_SHEET}"
                    sh "make pre-flight-check"
                    currentBuild.description = env.RELEASE
                }
            }
        }

        stage('Validate') {
            parallel {
                stage('Assets') {
                    steps {
                        script {
                            sh "make validate-assets"
                        }
                    }
                }
                stage("Charts and Images") {
                    steps {
                        sh "make validate-images"
                    }
                }
                stage('RPMs') {
                    steps {
                        sh """
                            make validate-rpms
                            make validate-embedded-repo
                        """
                    }
                }
                stage("API Documentation") {
                    environment {
                        GIT_AUTHOR_NAME = "Jenkins"
                        GIT_AUTHOR_EMAIL = "jenkins@algol60.net"
                        GIT_COMMITTER_NAME = "Jenkins"
                        GIT_COMMITTER_EMAIL = "jenkins@algol60.net"
                        EMAIL = "jenkins@algol60.net"
                    }
                    when {
                        expression { env.RELEASE_DOCS_CSM == "true" }
                    }
                    agent {
                        label "metal-gcp-builder"
                    }
                    steps {
                        script {
                            env.GITHUB_APP_INST_TOKEN = getGitHubToken(appId: "330087", installId: "37198173", credentialsId: "github-jenkins-auto-push-bot-key")
                            sh """
                                ./hack/gen-push-swagger-markdown.sh ${env.DOCS_CSM_BRANCH} ${isPublishedRelease() ? '--push --wait' : ''}
                            """
                        }
                    }
                }
            }
        }

        stage('Decide') {
            steps {
                script {
                    sh "make versions-digest"
                    if ( isPublishedRelease() ) {
                        println "Build on versioned tag detected, proceeding with the build."
                        csmUtils.postSlack(channel: env.SLACK_CHANNEL_NOTIFY, color: "#439fe0", message: "<${env.BUILD_URL}|CSM ${env.RELEASE_VERSION}> - Build starting")
                        COMPILE_BUILD = 1
                    } else if ( isIntegrationBuild() ) {
                        println "Integration nightly build detected. Comparing version digest with previous build ${env.RELEASE}."
                        rtDownload (
                            serverId: 'ARTIFACTORY_ALGOL60',
                            failNoOp: false,
                            spec: """{
                                "files": [
                                    {
                                        "pattern": "csm-releases/${env.RELEASE_NAME}/${env.RELEASE_MAJOR_MINOR}/${env.RELEASE}-versions.yaml",
                                        "target": "./${env.RELEASE}-versions-previous.yaml",
                                        "flat": true
                                    }
                                ]
                            }"""
                        )
                        if ( ! fileExists("${env.RELEASE}-versions-previous.yaml") ) {
                            println "Previous build version digest not found"
                            csmUtils.postSlack(channel: env.SLACK_CHANNEL_NOTIFY, color: "#439fe0", message: """
                                <${env.BUILD_URL}|CSM ${env.RELEASE_VERSION}> - Nightly build starting.
                                - No previous version digest found for CSM ${env.RELEASE_VERSION}
                                """.stripIndent().trim())
                            COMPILE_BUILD = 1
                        } else {
                            docsCsmVersion = readYaml(file: "${env.RELEASE}-versions-previous.yaml")?.rpm?.cray?.csm?.noos?.values()?.flatten()?.find{it.startsWith("docs-csm-")}?.replaceFirst(/^docs-csm-/, '')?.replaceFirst(/\.noarch$/, '')
                            if ( ! env.DOCS_CSM_VERSION ) {
                                echo "Environment variable DOCS_CSM_VERSION is not provided, looking for latest released docs-csm RPM."
                                env.DOCS_CSM_VERSION = sh(returnStdout: true, script: "bash hack/get-docs-csm-version.sh").trim()
                            }
                            sh """echo 'Filtering and sorting versions digest from previous build'; yq -P 'del(.rpm.cray.csm.noos.*.[] | select(. == "docs-csm-*")) | sort_keys(..)' ${env.RELEASE}-versions-previous.yaml > ${env.RELEASE}-versions-previous-no-docs.yaml"""
                            sh """echo 'Filtering and sorting versions digest from current build'; yq -P 'del(.rpm.cray.csm.noos.*.[] | select(. == "docs-csm-*")) | sort_keys(..)' dist/${env.RELEASE}-versions.yaml > dist/${env.RELEASE}-versions-no-docs.yaml"""
                            changes = sh(returnStdout: true, label: "Calculating diff", script: "diff ${env.RELEASE}-versions-previous-no-docs.yaml dist/${env.RELEASE}-versions-no-docs.yaml || true").trim()
                            println("Previous docs-csm version: ${docsCsmVersion}")
                            println("Current docs-csm version: ${env.DOCS_CSM_VERSION}")
                            sh "echo 'Previous versions digest:'; cat ${env.RELEASE}-versions-previous-no-docs.yaml"
                            sh "echo 'Current versions digest:'; cat dist/${env.RELEASE}-versions-no-docs.yaml"
                            if ( changes || docsCsmVersion != env.DOCS_CSM_VERSION ) {
                                lines = changes.split("\n")
                                if ( docsCsmVersion != env.DOCS_CSM_VERSION ) {
                                    lines = ["docs-csm: ${docsCsmVersion} > ${env.DOCS_CSM_VERSION}", *lines]
                                }
                                println("Changes detected:\n\n${lines.join('\n')}")
                                if ( lines.size() > 10 ) {
                                    lines = lines[0..10] + ["..."]
                                }
                                if ( docsCsmVersion != env.DOCS_CSM_VERSION && ! changes ) {
                                    message = "Docs-csm change only detected. Will skip build, and perform vShasta deployments only."
                                    COMPILE_BUILD = 2
                                } else {
                                    message = "Nightly build starting."
                                    COMPILE_BUILD = 1
                                }
                                csmUtils.postSlack(channel: env.SLACK_CHANNEL_NOTIFY, color: "#439fe0", message: """
                                    <${env.BUILD_URL}|CSM ${env.RELEASE_VERSION}> - ${message}
                                    Changes since previous build:
                                    ```
                                    """.stripIndent() +
                                    lines.join("\n") +
                                    """
                                    ```
                                    """.stripIndent()
                                )
                            } else {
                                println "No changes detected, skipping build"
                                csmUtils.postSlack(channel: env.SLACK_CHANNEL_NOTIFY, color: "#cccccc", message: """
                                    <${env.BUILD_URL}|CSM ${env.RELEASE_VERSION}> - No changes detected, skip nightly build.
                                    """.stripIndent().trim())
                            }
                        }
                    }
                }
            }
        }

        stage('Prepare Release') {
            when { expression { COMPILE_BUILD == 1 } }
            parallel {
                stage('Assets') {
                    steps {
                        script {
                            sh "make assets"
                        }
                    }
                }
                stage('RPMs') {
                    steps {
                        sh """
                            make rpms
                            make embedded-repo
                        """
                    }
                }
                stage('Charts and Images') {
                    steps {
                        sh """
                            make charts
                            make images
                        """
                    }
                }
            }
        }

        stage('Scan') {
            when { expression { COMPILE_BUILD == 1 } }
            parallel {
                stage('Snyk Scan') {
                    steps {
                        script {
                            sh "make snyk"
                        }
                    }
                }
                stage('Cosign Verify') {
                    steps {
                        script {
                            sh "make image-signatures"
                        }
                    }
                }
                stage('Pluto Scan') {
                    steps {
                        script {
                            sh "make pluto"
                        }
                    }
                }
            }
        }

        stage('Package') {
            when { expression { COMPILE_BUILD == 1 } }
            steps {
                script {
                    sh "make package"
                }
            }
        }

        stage('Publish') {
            when { expression { COMPILE_BUILD } }
            steps {
                script {
                    if ( COMPILE_BUILD == 1 ) {
                        archiveArtifacts(artifacts: 'dist/pluto-report.txt', allowEmptyArchive: true)
                        rtUpload (
                            serverId: 'ARTIFACTORY_ALGOL60',
                            failNoOp: true,
                            spec: """{
                                "files": [
                                    {
                                        "pattern": "dist/${env.RELEASE}.tar.gz",
                                        "target": "csm-releases/${env.RELEASE_NAME}/${env.RELEASE_MAJOR_MINOR}/"
                                    },
                                    {
                                        "pattern": "dist/${env.SNYK_RESULTS_FILENAME}",
                                        "target": "csm-releases/${env.RELEASE_NAME}/${env.RELEASE_MAJOR_MINOR}/"
                                    },
                                    {
                                        "pattern": "dist/${env.RELEASE}-test-results.tar.gz",
                                        "target": "csm-releases/${env.RELEASE_NAME}/${env.RELEASE_MAJOR_MINOR}/"
                                    },
                                    {
                                        "pattern": "dist/${env.RELEASE}-snyk-results.xlsx",
                                        "target": "csm-releases/${env.RELEASE_NAME}/${env.RELEASE_MAJOR_MINOR}/"
                                    },
                                    {
                                        "pattern": "dist/${env.RELEASE}-images.txt",
                                        "target": "csm-releases/${env.RELEASE_NAME}/${env.RELEASE_MAJOR_MINOR}/"
                                    },
                                    {
                                        "pattern": "dist/${env.RELEASE}-chartmap.csv",
                                        "target": "csm-releases/${env.RELEASE_NAME}/${env.RELEASE_MAJOR_MINOR}/"
                                    }
                                ]
                            }"""
                        )
                        csmUtils.postSlack(channel: env.SLACK_CHANNEL_NOTIFY, color: "good", message: """
                        <${env.BUILD_URL}|CSM ${env.RELEASE_VERSION}> - :white_check_mark: Success!
                            - Release distribution: <${env.RELEASE_URL}|${env.RELEASE_NAME}-${env.RELEASE_VERSION}.tar.gz>
                            - Deprecated API usage: <${env.BUILD_URL}/artifact/dist/pluto-report.txt|pluto-report.txt>
                            - Snyk results: <${env.SNYK_RESULTS_SHEET_URL}|${env.SNYK_RESULTS_SHEET}> (raw scan results: <${env.SNYK_RESULTS_URL}|${env.SNYK_RESULTS_FILENAME}>)
                            """.stripIndent().trim())
                    }
                    // Upload version digest even if COMPILE_BUILD == 2, i.e. pipeline was invoked for docs-csm change only, and no build was compiled
                    rtUpload (
                        serverId: 'ARTIFACTORY_ALGOL60',
                        failNoOp: true,
                        spec: """{
                            "files": [
                                {
                                    "pattern": "dist/${env.RELEASE}-versions.yaml",
                                    "target": "csm-releases/${env.RELEASE_NAME}/${env.RELEASE_MAJOR_MINOR}/"
                                }
                            ]
                        }"""
                    )
                    // If it was not nightly build, store versions as nightly digest as well to avoid unnecessary builds the same day.
                    def nightlyVersion = env.RELEASE_VERSION.split("-")[0] + "-nightly.1"
                    if ( nightlyVersion != env.RELEASE_VERSION ) {
                        rtUpload (
                            serverId: 'ARTIFACTORY_ALGOL60',
                            failNoOp: true,
                            spec: """{
                                "files": [
                                    {
                                        "pattern": "dist/${env.RELEASE}-versions.yaml",
                                        "target": "csm-releases/${env.RELEASE_NAME}/${env.RELEASE_MAJOR_MINOR}/csm-${nightlyVersion}-versions.yaml"
                                    }
                                ]
                            }"""
                        )
                    }
                }
            }
        }
    }
    post {
        success {
            script {
                archiveArtifacts(artifacts: 'dist/csm-*-images.txt', allowEmptyArchive: true)
                archiveArtifacts(artifacts: 'dist/csm-*-chartmap.csv', allowEmptyArchive: true)
                archiveArtifacts(artifacts: 'dist/csm-*-versions.yaml', allowEmptyArchive: true)
                if ( isPublishedRelease() || (isIntegrationBuild() && COMPILE_BUILD)) {
                    if ( env.VSHASTA_INSTALL == "true" ) {
                        // Fresh install current build on yasha
                        build(job: "Cray-HPE/csm-vshasta-deploy/main", wait: false, parameters: [
                            // Test fresh installs on yasha
                            string(name: "ENVIRONMENT", value: env.CSM_VSHASTA),
                            // Install version which was just built
                            string(name: "CSM_RELEASE", value: env.RELEASE_VERSION),
                            // Override docs-csm version, in case if dev version was picked by integration build
                            string(name: "DOCS_CSM_VERSION", value: env.DOCS_CSM_VERSION),
                            // Where to report results
                            string(name: "SLACK_REPORT_CHANNEL", value: env.SLACK_CHANNEL_NOTIFY)
                        ])
                    }
                    if ( env.VSHASTA_UPGRADE == "true" ) {
                        // Upgrade last previous release to current build on vex
                        build(job: "Cray-HPE/csm-vshasta-deploy/main", wait: false, parameters: [
                            // Test upgrades on vex
                            string(name: "ENVIRONMENT", value: env.CSM_VSHASTA_UPGRADE),
                            // Automatically evaluate last previous release e.g. 1.4.3
                            string(name: "CSM_RELEASE", value: ""),
                            // Upgrade to what had been just built
                            string(name: "CSM_RELEASE_UPGRADE", value: env.RELEASE_VERSION),
                            // Upgrade after fresh install
                            booleanParam(name: "UPGRADE", value: true),
                            // Override docs-csm version, in case if dev version was picked by integration build
                            string(name: "DOCS_CSM_VERSION_UPGRADE", value: env.DOCS_CSM_VERSION),
                            // Where to report
                            string(name: "SLACK_REPORT_CHANNEL", value: env.SLACK_CHANNEL_NOTIFY)
                        ])
                    }
                    if ( env.SEND_SNYK_REPORT == "true" && COMPILE_BUILD == 1 ) {
                        build(job: "Cray-HPE/csm-snyk-scan/main", wait: false, parameters: [
                            string(name: "CSM_RELEASE", value: "${env.RELEASE_VERSION}"),
                            string(name: "SLACK_CHANNEL", value: "${env.SNYK_REPORT_CHANNEL}")
                        ])
                    }
                }
                if ( isPublishedRelease() && env.UPLOAD_TO_CSMPIT == "true" ) {
                    build(job: "Cray-HPE/csm-release-internal-upload/main", wait: false, parameters: [
                        string(name: "RELEASE_VERSION", value: "${env.RELEASE_VERSION}"),
                    ])
                }
            }
        }
        failure {
            script {
                if ( isPublishedRelease() ) {
                    csmUtils.postSlack(channel: env.SLACK_CHANNEL_NOTIFY, color: "danger", message: "<${env.BUILD_URL}|CSM ${env.RELEASE_VERSION}> - :x: Build did not complete successfully")
                }
            }
        }
        aborted {
            script {
                if ( isPublishedRelease() ) {
                    csmUtils.postSlack(channel: env.SLACK_CHANNEL_NOTIFY, color: "warning", message: "<${env.BUILD_URL}|CSM ${env.RELEASE_VERSION}> - :warning: Job was aborted")
                }
            }
        }
    }
}
